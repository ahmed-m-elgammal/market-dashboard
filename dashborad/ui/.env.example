# Copy to `.env` and fill in. `.env` is gitignored — never commit keys.
#
# Same Supabase project as apps/admin: auojqkivsplvdajjdabe
# VITE_ vars are baked into the browser bundle at build time, so ONLY the
# anon/publishable key belongs here. The service_role key stays server-side in
# the admin-api Edge Function and must never appear in this file.

VITE_SUPABASE_URL=https://auojqkivsplvdajjdabe.supabase.co

# The anon / publishable key. RLS applies to it: it cannot read pending
# merchants or moderation queues. Every privileged read goes through the
# admin-api Edge Function.
VITE_SUPABASE_ANON_KEY=

# Base URL of the admin-api Edge Function. Leave as-is for local dev.
VITE_ADMIN_API_URL=https://auojqkivsplvdajjdabe.supabase.co/functions/v1/admin-api